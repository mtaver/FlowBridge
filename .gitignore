# Python virtual environments
.venv/
venv/

# Python cache files
__pycache__/
*.py[cod]

# Generated data files
data/raw/*.xlsx
data/processed/*.xlsx

# Generated SQLite databases and temporary files
data/database/*.db
data/database/*.db-*

# Generated Power BI exports
data/powerbi/*.csv

# Scheduled refresh logs
logs/

# Secrets and local environment settings
.env
.env.*
!.env.example
*.key
*.pem

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary Excel lock files
~$*.xlsx
